# =============================================================================
# E-SPORTS BANGLADESH (ESBD) - Environment Variables
# =============================================================================

# Server Port (for local development)
PORT=3000

# Your live site URL (used for OAuth callbacks and CORS)
SITE_URL=https://your-vercel-app.vercel.app

# JSON Web Token Secret — generate a long random string for production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-supabase-service-role-key

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Facebook OAuth ──────────────────────────────────────────────────────────
# Get from: https://developers.facebook.com/apps
# Valid OAuth redirect URI: {SITE_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ─── SMS / Phone OTP ─────────────────────────────────────────────────────────
# Provider: twilio | ssl_wireless | (blank = console log only for dev)
SMS_PROVIDER=
# Twilio credentials (if SMS_PROVIDER=twilio)
TWILIO_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1XXXXXXXXXX

